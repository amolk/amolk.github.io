---
layout: layout.njk
pagination:
  data: projects.tags
  size: 1
  alias: tag
permalink: "{{ tag.url }}"
eleventyComputed:
  title: "Projects tagged “{{ tag.label | safe }}”"
---
<header class="page-masthead tag-masthead"><div class="home-container">
  <a href="/projects/" class="portfolio-back">All projects</a>
  <h1>{{ tag.label }}</h1>
  <p class="page-masthead-description">{{ tag.projects.length }} project{% if tag.projects.length != 1 %}s{% endif %} exploring this topic.</p>
</div></header>
<div class="home-container portfolio-main"><div class="portfolio-grid">{% for project in tag.projects %}{% set showChildren = false %}{% include "portfolio-card.njk" %}{% endfor %}</div></div>
