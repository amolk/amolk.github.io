---
layout: layout.njk
pagination:
  data: projects.visible
  size: 1
  alias: project
permalink: "{{ project.url }}"
eleventyComputed:
  title: "{{ project.title | safe }}"
  description: "{{ project.summary | safe }}"
---
{% if project.explainer %}
{# Keep authored explainers independent, including the work-in-progress Unwind page. #}
<div class="case-explainer">{% include project.explainer %}</div>
{% else %}
{% set sections = project.body | projectSections %}
<article class="case-study home-container">
  <header class="case-header">
    <a href="/projects/" class="portfolio-back">All projects</a>
    {% if project.parentProject %}<p class="case-parent">Part of {% if project.parentProject.is_private %}{{ project.parentProject.title }}{% else %}<a href="{{ project.parentProject.url }}">{{ project.parentProject.title }}</a>{% endif %}</p>{% endif %}
    <h1>{{ project.title }}</h1>
    <p class="case-description">{{ project.summary | replace('`', '') }}</p>
    {% if project.links.length %}<div class="case-actions">{% for link in project.links %}<a href="{{ link.href }}" target="_blank" rel="noopener noreferrer">{{ link.label }}</a>{% endfor %}</div>{% endif %}
    <dl class="case-facts">
      <div><dt>Status</dt><dd class="case-status">{{ project.status }}</dd></div>
      <div><dt>Started</dt><dd>{{ project.year_started }}</dd></div>
      <div><dt>Focus</dt><dd>{{ homepage.categoryLabels[project.category] or project.category }}</dd></div>
      <div><dt>Topics</dt><dd>{% for tag in project.tagLinks %}<a href="{{ tag.url }}">{{ tag.label }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</dd></div>
    </dl>
  </header>
  {% if project.image %}<figure class="case-hero-media">{% set imageSource = project.image %}{% set imageWidth = 1600 %}{% set imageHeight = 900 %}{% set imageClass = "case-image" %}{% include "zoom-image.njk" %}</figure>{% endif %}
  {% if project.video %}<figure class="case-hero-media"><video controls preload="metadata" aria-label="{{ project.title }} demonstration"><source src="{{ project.video }}"></video></figure>{% endif %}
  <div class="case-content-layout{% if sections.length > 1 %} has-contents{% endif %}">
    {% if sections.length > 1 %}<nav class="case-contents" aria-label="On this page"><p>On this page</p>{% for section in sections %}<a href="#{{ section.id }}">{{ section.label }}</a>{% endfor %}</nav>{% endif %}
    <div class="case-reading project-content">{{ project.body | safe }}</div>
  </div>
  {% if project.children.length %}<section class="case-related" aria-labelledby="related-title"><h2 id="related-title">Related work</h2><div class="portfolio-grid">{% for project in project.children %}{% set showChildren = false %}{% include "portfolio-card.njk" %}{% endfor %}</div></section>{% endif %}
  {% if project.images.length %}<section class="case-gallery" aria-label="Project images">{% for source in project.images %}{% set imageSource = source %}{% set imageWidth = 1200 %}{% set imageHeight = 800 %}{% set imageClass = "case-image" %}{% include "zoom-image.njk" %}{% endfor %}</section>{% endif %}
  <div class="case-end"><a class="home-text-link" href="/projects/">Browse all projects</a></div>
</article>
{% endif %}
