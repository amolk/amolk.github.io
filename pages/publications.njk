---
layout: layout.njk
title: Publications
description: Peer-reviewed papers and patents on AI systems, conversational agents, and computational neuroscience.
permalink: /publications/
pageArtwork: /images/artwork/paper-strata.webp
---
<header class="page-masthead page-masthead-illustrated publications-masthead">
  {% include "page-artwork.njk" %}
  <div class="home-container"><div class="page-masthead-copy">
    <p class="home-eyebrow">Research &amp; patents</p>
    <h1>Publications</h1>
    <p class="page-masthead-description">Ideas on intelligence, from cortical networks to conversational AI.</p>
    <a class="home-text-link" href="{{ publications.scholar.url }}">View Google Scholar</a>
  </div></div>
</header>
<div class="home-container portfolio-main" data-publications>
  <div class="portfolio-toolbar" data-publication-controls hidden>
    <div class="publication-filter" role="group" aria-label="Filter publications"><button type="button" data-publication-filter="all" aria-pressed="true">All work</button><button type="button" data-publication-filter="paper" aria-pressed="false">Papers</button><button type="button" data-publication-filter="patent" aria-pressed="false">Patents</button></div>
    <p class="portfolio-result-count" data-publication-count role="status" aria-live="polite"></p>
  </div>
  {% for group in publications.years %}
  <section class="publication-year" data-publication-year aria-labelledby="year-{{ group.year }}">
    <h2 id="year-{{ group.year }}">{{ group.year }}</h2>
    <ol>{% for p in group.items %}<li class="publication-entry" data-publication-type="{{ p.type }}">
      <h3>{% if p.link %}<a href="{{ p.link }}">{{ p.title }}</a>{% else %}{{ p.title }}{% endif %}</h3>
      <p class="publication-authors">{{ p.authors }}</p>
      <div class="publication-venue"><span>{{ p.type }}</span><span>{{ p.venue }}</span>{% if p.citations %}<span>{{ p.citations }} citation{% if p.citations != 1 %}s{% endif %}</span>{% endif %}</div>
    </li>{% endfor %}</ol>
  </section>
  {% endfor %}
</div>
