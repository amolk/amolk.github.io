<div class="max-w-4xl mx-auto px-8 pt-24 pb-16"><header class="mb-12"><h1 class="font-serif text-4xl md:text-5xl font-medium tracking-tight mb-3">Publications</h1><p class="text-gray-500 text-lg font-light">Peer-reviewed papers and patents across AI systems, conversational agents, and computational neuroscience. Full list on <a href="https://scholar.google.com/citations?user=qKZ2VRAAAAAJ&amp;hl=en" class="underline underline-offset-4 hover:text-black">Google Scholar</a>.</p></header><ol class="space-y-4">{% for p in publications.sorted %}<li class="group p-5 rounded-xl border border-gray-200 hover:border-gray-400 hover:bg-white transition-all duration-300"><div class="flex items-baseline justify-between gap-3 mb-1"><h2 class="font-serif text-lg font-medium leading-snug">{% if p.link %}<a href="{{ p.link }}" class="group-hover:underline underline-offset-4">{{ p.title }}</a>{% else %}<span>{{ p.title }}</span>{% endif %}</h2><span class="text-xs text-gray-400 whitespace-nowrap font-light">{{ p.year }}</span></div><p class="text-sm text-gray-500 font-light mb-1.5">{{ p.authors }}</p><div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-gray-600"><span class="text-xs px-2.5 py-0.5 rounded-full bg-gray-100 text-gray-600 capitalize">{{ p.type }}</span><span>{{ p.venue }}</span>{% if p.citations %}<span class="text-gray-400">· {{ p.citations }} citations</span>{% endif %}</div></li>{% endfor %}</ol></div>
