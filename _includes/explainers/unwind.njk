  .ex code { font-family: "Source Code Pro", ui-monospace, monospace; font-size: 0.92em; background: #f3f4f6; padding: 0.1em 0.4em; border-radius: 0.3rem; }

  .ex-meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
