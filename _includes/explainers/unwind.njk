  /* Feature rows */
  .ex-feature { display: grid; gap: 1.25rem; align-items: center; padding: 2rem 0; border-top: 1px solid var(--line); }
  @media (min-width: 768px) { .ex-feature { grid-template-columns: 5fr 7fr; gap: 2.5rem; } .ex-feature.flip > :first-child { order: 2; } }
  .ex-tag { display: inline-block; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.2rem 0.6rem; border-radius: 999px; margin-bottom: 0.6rem; }
