{% set timeline = projects.timeline %}
<div class="timeline-frame" data-timeline data-min-year="{{ timeline.minYear }}" data-latest-end="{{ timeline.latestEnd }}" style="--timeline-row-count: {{ timeline.rows.length }}">
  <div class="timeline-scroll" data-timeline-scroll role="region" aria-label="Project timeline. All {{ timeline.rows.length }} projects and years fit initially. Pinch or use the zoom controls to enlarge, then scroll in either direction." tabindex="0">
    <div class="timeline-chart">
      <div class="timeline-axis">
        <span class="timeline-label timeline-axis-label">Project</span>
        <div class="timeline-years" data-year-labels>
          {% for point in timeline.years %}<span class="timeline-year-label" style="left:{{ point.left }}%" data-year="{{ point.year }}">{{ point.year }}</span>{% endfor %}
        </div>
      </div>
      <div class="timeline-body">
        <div class="timeline-grid" data-year-grid aria-hidden="true">
          {% for point in timeline.years %}<span class="timeline-year-line" style="left:{{ point.left }}%" data-year="{{ point.year }}"></span>{% endfor %}
          <span class="timeline-today" style="left:100%" data-today></span>
        </div>
        {% for row in timeline.rows %}
        <a href="{{ row.project.url }}" class="timeline-row" title="{{ row.project.summary }}">
          <span class="timeline-label">{{ row.project.title }}</span>
          <span class="timeline-ranges">
            {% for range in row.ranges %}<span class="timeline-range {{ row.color }}" style="left:{{ range.left }}%;width:{{ range.width }}%" title="{{ range.title }}" data-range-start="{{ range.start }}" data-range-end="{{ range.end }}"></span>{% endfor %}
          </span>
        </a>
        {% endfor %}
      </div>
    </div>
  </div>
  <div class="timeline-footer">
    <div class="timeline-legend" aria-label="Project status legend">
      {% for status in timeline.legend %}<span><i class="{{ status.color }}" aria-hidden="true"></i>{{ status.label }}</span>{% endfor %}
    </div>
    <div class="timeline-zoom" data-timeline-zoom role="group" aria-label="Timeline zoom" hidden>
      <button type="button" data-timeline-zoom-out aria-label="Zoom out timeline" disabled>−</button>
      <output data-timeline-zoom-level aria-label="Timeline zoom level" aria-live="off">100%</output>
      <button type="button" data-timeline-zoom-in aria-label="Zoom in timeline">+</button>
      <button type="button" data-timeline-fit>Fit</button>
    </div>
  </div>
</div>
