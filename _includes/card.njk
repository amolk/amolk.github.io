<div class="group p-6 rounded-2xl border border-gray-200 hover:border-gray-400 hover:bg-white transition-all duration-300">
  <a href="{{ project.url }}" class="block">
    {% if showChildren and project.parentLabel %}<div class="text-[11px] uppercase tracking-wide text-gray-400 mb-1">{{ project.parentLabel }}</div>{% endif %}
    <div class="flex items-baseline justify-between gap-3 mb-3">
      <h3 class="font-serif text-xl font-medium group-hover:underline underline-offset-4">{{ project.title }}</h3>
      <span class="text-xs text-gray-400 whitespace-nowrap font-light">{{ project.years }}</span>
    </div>
    <p class="text-sm text-gray-600 mb-4 leading-tight">{{ project.summary }}</p>
    <div class="flex flex-wrap gap-1.5">
      <span class="text-xs px-2.5 py-0.5 rounded-full bg-gray-100 text-gray-600 capitalize">{{ project.status }}</span>
      {% for tag in project.tags | take(3) %}<span class="text-xs px-2.5 py-0.5 rounded-full bg-gray-100 text-gray-600">{{ tag }}</span>{% endfor %}
    </div>
  </a>
  {% if showChildren and project.children.length %}
  <div class="mt-4 pt-3 border-t border-gray-100">
    <div class="text-[11px] uppercase tracking-wide text-gray-400 mb-1.5">Includes</div>
    <div class="flex flex-wrap gap-x-3 gap-y-1">
      {% for child in project.children %}<a href="{{ child.url }}" class="text-sm text-gray-700 hover:text-black underline underline-offset-2 decoration-gray-300">{{ child.title }}</a>{% endfor %}
    </div>
  </div>
  {% endif %}
</div>
