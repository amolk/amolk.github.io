<!doctype html>
<html lang="en" class="portfolio-font">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if pageTitle %}{{ pageTitle }}{% else %}{% if title %}{{ title }} - {% endif %}{{ site.title }}{% endif %}</title>
{% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
<meta name="description" content="{{ description or site.description }}">
{% set socialTitle = pageTitle or title or site.title %}
{% set socialDescription = description or site.description %}
{% set socialImage = (project and project.image) or pageArtwork or '/images/home/living-systems-warm.webp' %}
<link rel="canonical" href="{{ site.siteUrl }}{{ page.url }}">
<meta property="og:title" content="{{ socialTitle }}"><meta property="og:description" content="{{ socialDescription }}"><meta property="og:url" content="{{ site.siteUrl }}{{ page.url }}"><meta property="og:site_name" content="{{ site.title }}"><meta property="og:type" content="{% if project %}article{% else %}website{% endif %}"><meta property="og:image" content="{{ site.siteUrl }}{{ socialImage }}"><meta property="og:image:alt" content="{% if project and project.image %}{{ project.title }}{% else %}Sculptural forms in a blue gray landscape{% endif %}">
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="{{ socialTitle }}"><meta name="twitter:description" content="{{ socialDescription }}"><meta name="twitter:image" content="{{ site.siteUrl }}{{ socialImage }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin>
<meta name="theme-color" content="#edf2f6">
{% if home %}<script src="/assets/home-direction.js"></script>{% endif %}
{% if pageArtwork %}<link rel="preload" as="image" href="{{ pageArtwork }}">{% endif %}
<link rel="stylesheet" href="/assets/site.css">
<script src="/assets/home.js" defer></script>
{% if not home %}<script src="/assets/site.js" defer></script><script src="/assets/portfolio.js" defer></script>{% endif %}
</head>
<body class="home-page{% if not home %} portfolio-page{% endif %}">
<a class="home-skip" href="#main-content">Skip to content</a>{% include "home-nav.njk" %}
<main id="main-content">{{ content | safe }}</main>
{% include "home-footer.njk" %}
</body></html>
