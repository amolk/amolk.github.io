{
  "name": "amolk-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run css && eleventy --serve --port=3000 --watch",
    "css": "postcss styles/site.css -o public/assets/site.css",
    "build": "node scripts/clean.mjs && npm run css && eleventy && npm run verify",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-build.mjs",
    "format": "prettier --write .",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.5.0",
    "cheerio": "^1.2.0",
    "gray-matter": "^4.0.3",
    "postcss": "^8",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.1",
    "prettier": "^3.3.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-prism-plus": "^2.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5",
    "wrangler": "^4.152.0"
  }
}
